# ------------------------------------------------------------------
# SiapDeal MVP — local-first demo
# Supabase tidak diperlukan. Sesi dan skor disimpan di localStorage.
# ------------------------------------------------------------------

# AI provider (wajib untuk chat, evaluasi, dan transkripsi)
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyDUMMY_KEY_REPLACE_ME
# GEMINI_API_KEY=AIzaSyDUMMY_KEY_REPLACE_ME   # alternatif nama variabel
# OPENAI_API_KEY=sk-dummy-replace-me          # dipakai jika Google kosong

# Model AI
AI_MODEL=gemini-3.5-flash-lite
AI_EVAL_MODEL=gemini-3.5-flash-lite
AI_EVAL_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# URL aplikasi (dipakai untuk metadata/redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Catatan deployment Vercel:
# Tambahkan GOOGLE_GENERATIVE_AI_API_KEY dan AI_MODEL di Environment
# Variables Vercel. Tidak ada environment Supabase yang dibutuhkan.
# ------------------------------------------------------------------
