NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy

# ------------------------------------------------------------------
# AI Provider â€” isi salah satu.
# Rekomendasi: Google Gemini (tersedia tier gratis).
# ------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyDUMMY_KEY_REPLACE_ME
# GEMINI_API_KEY=AIzaSyDUMMY_KEY_REPLACE_ME   # alternatif nama variabel
# OPENAI_API_KEY=sk-dummy-replace-me          # dipakai jika Google kosong

# Opsional. Default: gemini-3.5-flash / gpt-4o-mini
AI_MODEL=gemini-3.5-flash

# Opsional. Model evaluasi + fallback saat model utama sibuk.
AI_EVAL_MODEL=gemini-3.5-flash
AI_EVAL_FALLBACK_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------
# Quick Demo Login untuk juri Bali DigiFest
# ------------------------------------------------------------------
# Aktifkan Authentication â†’ Providers â†’ Anonymous di Supabase.
# Juri akan otomatis dibuatkan akun anonim dengan role `authenticated`.
JUDGE_ANONYMOUS_ENABLED=true

# Opsional: akun demo tetap (lebih stabil & bisa dipakai berulang).
# Buat user ini di Supabase Authentication â†’ Users, lalu isi kredensialnya.
# Jika diisi, SiapDeal mencoba akun ini lebih dulu sebelum anonymous login.
# DEMO_JUDGE_EMAIL=juri@siapdeal.id
# DEMO_JUDGE_PASSWORD=ganti-password-kuat

# ------------------------------------------------------------------
# URL aplikasi (dipakai untuk redirect email konfirmasi & metadata)
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

